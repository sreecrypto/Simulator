# Optional: copy to .env and start with: node --env-file=.env server.mjs
PORT=3000
# Install and run Ollama separately, then set the name of a downloaded model.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Optional nonlinear/full-SPICE engine executable (install separately).
# NGSPICE_BIN=C:\Spice64\bin\ngspice_con.exe
# External model search uses Firecrawl's public API; a key raises provider limits.
# FIRECRAWL_API_KEY=
# Set to 0 to disable external model discovery.
MODEL_SEARCH_ENABLED=1
