# Optional: copy to .env. The server loads it at startup.
PORT=3000
# Start Ollama separately. Set an installed model name, or leave blank to auto-detect.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Example: OLLAMA_MODEL=TinyLlama:latest
# Optional Copilot cloud providers. Set your own keys in .env and restart.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-carbon
XAI_API_KEY=
GROK_MODEL=grok-4.7
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional nonlinear/full-SPICE engine executable (install separately).
# NGSPICE_BIN=C:\Spice64\bin\ngspice_con.exe
# Optional Icarus Verilog tools for generated testbench verification.
# IVERILOG_BIN=C:\iverilog\bin\iverilog.exe
# VVP_BIN=C:\iverilog\bin\vvp.exe
# External model search uses Firecrawl's public API; a key raises provider limits.
# FIRECRAWL_API_KEY=
# Set to 0 to disable external model discovery.
MODEL_SEARCH_ENABLED=1
